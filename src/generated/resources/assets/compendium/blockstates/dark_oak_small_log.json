{
  "multipart": [
    {
      "apply": {
        "model": "compendium:block/small_log_horizontal2"
      },
      "when": {
        "OR": [
          {
            "north": "true"
          },
          {
            "south": "true"
          }
        ]
      }
    },
    {
      "apply": {
        "model": "compendium:block/small_log_horizontal"
      },
      "when": {
        "OR": [
          {
            "west": "true"
          },
          {
            "east": "true"
          }
        ]
      }
    },
    {
      "apply": {
        "model": "compendium:block/small_log_vertical"
      }
    },
    {
      "apply": {
        "model": "compendium:block/small_log_cap"
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "compendium:block/small_log_cap",
        "x": 180
      },
      "when": {
        "down": "true"
      }
    },
    {
      "apply": {
        "model": "compendium:block/small_log_cap",
        "x": 90
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "compendium:block/small_log_cap",
        "x": 90,
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "compendium:block/small_log_cap",
        "x": 90,
        "y": -90
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "compendium:block/small_log_cap",
        "x": 90,
        "y": 90
      },
      "when": {
        "east": "true"
      }
    }
  ]
}